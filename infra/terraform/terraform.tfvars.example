# Copy this file to terraform.tfvars and fill in your values.
# terraform.tfvars is gitignored — never commit it (it contains your email addresses).

region         = "us-east-1"
domain_name    = "lineuplines.com"          # The domain you registered
ses_from_email = "feedback@lineuplines.com" # Must be verified in SES
ses_to_email   = "dacalw26@email.com"           # Where you want to receive feedback

# Bearer token for GET /api/v1/summary — pick any long random string.
# e.g. generate one with: openssl rand -hex 32
analytics_admin_token = "changeme"

# Optional — Slack incoming webhook URL for the adp_scrape_dag on_failure
# alerts. Leave unset/empty and task failures just won't be notified anywhere.
# https://api.slack.com/messaging/webhooks
# slack_webhook_url = "https://hooks.slack.com/services/changeme"
